[Unit]
Description=Prometheus NUT exporter (apc@localhost)
After=nut-server.service
Wants=nut-server.service

[Service]
ExecStart=/usr/local/bin/nut_exporter --nut.server=127.0.0.1 --web.listen-address=:9199
DynamicUser=yes
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
