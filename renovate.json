{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "branchConcurrentLimit": 50,
  "prConcurrentLimit": 20,
  "prHourlyLimit": 20,
  "pruneBranchAfterAutomerge": true,
  "dependencyDashboard": true,
  "dependencyDashboardAutoclose": true,
  "osvVulnerabilityAlerts": true,
  "rollbackPrs": true,
  "ignorePaths": [
    "sealed-secrets/**"
  ],
  "enabledManagers": [
    "kubernetes",
    "helm-values",
    "flux",
    "kustomize",
    "docker-compose",
    "gitlabci",
    "custom.regex"
  ],
  "docker-compose": {
    "managerFilePatterns": ["infra/edge/compose/**/compose.yaml"]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "apps/**/*.yaml",
      "helm/*.yaml",
      "monitoring/**/*.yaml",
      "gitlab/**/*.yaml",
      "infra/**/*.yaml",
      "cluster-config/**/*.yaml",
      "cluster-addons/**/*.yaml"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      ".*\\/values\\.ya?ml$"
    ]
  },
  "flux": {
    "managerFilePatterns": ["clusters/home/flux-system/**/*.yaml", "apps/**/*.yaml", "helm/*.yaml", "monitoring/**/*.yaml", "gitlab/**/*.yaml", "infra/**/*.yaml", "cluster-config/**/*.yaml"]
  },
  "hostRules": [
        {
      "matchHost": "index.docker.io",
      "concurrentRequestLimit": 1
    },
    {
      "matchHost": "hub.docker.com",
      "concurrentRequestLimit": 1
    },
    {
      "hostType": "helm",
      "matchHost": "pmint93.github.io",
      "registryUrls": ["https://pmint93.github.io/helm-charts"]
    },
    {
      "hostType": "helm",
      "matchHost": "charts.goauthentik.io",
      "registryUrls": ["https://charts.goauthentik.io"]
    },
    {
      "hostType": "helm",
      "matchHost": "stakater.github.io",
      "registryUrls": ["https://stakater.github.io/stakater-charts/"]
    },
    {
      "hostType": "helm",
      "matchHost": "prometheus-community.github.io",
      "registryUrls": ["https://prometheus-community.github.io/helm-charts/"]
    },
    {
      "hostType": "helm",
      "matchHost": "immich-app.github.io",
      "registryUrls": ["https://immich-app.github.io/immich-charts/"]
    }
  ],
  "registryAliases": {
    "pmint93": "https://pmint93.github.io/helm-charts"
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["infra/crowdsec/helmrelease.yaml"],
      "matchStrings": ["tag: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "crowdsecurity/crowdsec",
      "datasourceTemplate": "docker"
    },
    {
      "description": "CNPG: версия PostgreSQL задаётся через spec.imageName, штатный kubernetes-менеджер её не видит",
      "customType": "regex",
      "managerFilePatterns": ["apps/postgres/cnpg-cluster.yaml", "parapar-dr/cluster.yaml"],
      "matchStrings": ["imageName:\\s*(?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>[0-9][^\\s@#]*)"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/haveagitgat/tdarr",
        "ghcr.io/haveagitgat/tdarr_node"
      ],
      "groupName": "tdarr docker images"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "groupName": "immich docker images"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres", "mysql", "mariadb", "redis"],
      "automerge": false,
      "assignees": ["progist"]
    },
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["minor"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "assignees": ["progist"]
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "linuxserver/transmission",
        "lscr.io/linuxserver/transmission"
      ],
      "allowedVersions": "<2000",
      "versioning": "semver"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["homeassistant/home-assistant"],
      "versioning": "regex:^?(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d+)$",
      "groupName": "Home Assistant Docker Image",
      "automerge": true
    },
    {
      "matchFileNames": ["apps/immich/helm-release.yaml"],
      "matchDatasources": ["helm"],
      "automerge": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["minio/minio", "minio/mc", "pgsty/silo", "pgsty/mc"],
      "versioning": "regex:^RELEASE\\.(?<major>\\d+)-(?<minor>\\d+)-(?<patch>\\d+)T"
    },
    {
      "description": "Jellyfin 12.x выходит с двухсегментными тегами (12.2), docker-версионирование требует то же число сегментов, что у 10.11.11, и молча пропускает обновления.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["jellyfin/jellyfin"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(\\.(?<patch>\\d+))?$"
    },
    {
      "description": "CNPG PostgreSQL: только ручной мёрдж; major держим явно (apps-pg 17, parapar-dr 16), смена major = отдельная миграция.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "automerge": false,
      "assignees": ["progist"]
    },
    {
      "matchFileNames": ["apps/postgres/cnpg-cluster.yaml"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "allowedVersions": "/^17\\./"
    },
    {
      "matchFileNames": ["parapar-dr/cluster.yaml"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "allowedVersions": "/^16\\./"
    },
    {
      "description": "Stateful-приложения с миграциями данных/индекса: minor может ломать формат (Meilisearch 1.41→1.55). Только ручной мёрдж.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["getmeili/meilisearch", "ghcr.io/karakeep-app/karakeep", "n8nio/n8n"],
      "automerge": false,
      "assignees": ["progist"]
    },
    {
      "description": "Edge VPS (headscale, frps, tailscale) и subnet router'ы дома: аварийный путь в сеть, 0.x-релизы headscale/frp, minor бывают ломающими. Только ручной мердж; правило стоит последним, чтобы перекрыть глобальный automerge.",
      "matchFileNames": ["infra/edge/**", "infra/tailscale/**"],
      "automerge": false,
      "assignees": ["progist"],
      "addLabels": ["edge"]
    }
  ]
}
