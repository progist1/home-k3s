# /etc/nut/upsmon.conf на k3s-pi (apt install nut-client). Пароль подставить.
MONITOR apc@10.77.20.6:3493 1 pi CHANGE_ME_3 secondary
MINSUPPLIES 1
SHUTDOWNCMD "/sbin/shutdown -h +0"
POLLFREQ 5
POLLFREQALERT 5
HOSTSYNC 15
DEADTIME 60
NOCOMMWARNTIME 300
FINALDELAY 5
NOTIFYFLAG ONBATT SYSLOG
NOTIFYFLAG ONLINE SYSLOG
NOTIFYFLAG FSD    SYSLOG+WALL
NOTIFYFLAG SHUTDOWN SYSLOG+WALL
